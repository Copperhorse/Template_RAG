# Copy to .env (git-ignored). Real environment variables always win over this file.

# --- LLM (any OpenAI-compatible server; only `rag ask` and the optional `rag enrich` need it) ---
# Local: scripts/serve_llm.sh serves Gemma 4 E2B with llama.cpp on :8080 (reasoning must be off for JSON replies)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local-model            # llama-server ignores it; hosted APIs need a real id
LLM_API_KEY=no-key
LLM_TIMEOUT_S=120
LLM_REASONING_BUDGET=0           # 0 for non-reasoning models (and Gemma 4 with --reasoning off); -1 = unlimited (capped)
LLM_JSON_MODE=schema             # schema (the default) | json_object | off. schema makes llama.cpp enforce the reply's keys with a grammar:
                                 # without it Gemma 4 E2B leaves out the required quotes about 2/3 of the time. Needs a server that supports
                                 # response_format json_schema (llama.cpp, vLLM, Ollama, OpenAI do); set off for one that does not.

# --- Storage ---
RAG_DATA_DIR=./data              # holds rag.db and the vector store
# RAG_DB_PATH=./data/rag.db
# RAG_VECTOR_STORE=chroma        # chroma | memory
# RAG_VECTOR_DIR=./data/vectors

# --- Embeddings ---
RAG_EMBEDDER=sentence-transformers   # sentence-transformers | openai | hash (tests/dev only)
RAG_EMBED_MODEL=google/embeddinggemma-2
RAG_EMBED_DTYPE=auto             # auto (bfloat16 on GPU) | bfloat16 | float32.  NOT float16: EmbeddingGemma 2 returns NaN in it
RAG_EMBED_MODALITIES=text        # text = the 270M text encoder only; "text,image" also loads the 170M vision encoder
# RAG_EMBED_DIM=256              # Matryoshka truncation (128/256/512/768); vectors are re-normalised
# RAG_QUERY_TASK=code retrieval  # task prefix for task-aware embedders; default "search result"
# QP_DEVICE=cpu                  # force cpu / cuda:1 / mps

# --- Reranker (second stage over the fused candidates) ---
# Default: jinaai/jina-reranker-v3.5, a 0.6B *listwise* reranker (reads the query and all candidates in one pass).
#   !! LICENCE: CC-BY-NC-4.0, NON-COMMERCIAL use only. Check it before using this template in a product.
#   !! It ships its own modeling code, so loading it needs trust_remote_code. rerankers.py pins the audited commit and trusts
#      only that exact (model, commit) pair; any other custom-code model needs RAG_TRUST_REMOTE_CODE=1.
#   Any sentence-transformers CrossEncoder id also works, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 (Apache-2.0).
RAG_RERANK=auto                  # auto (fall back to ms-marco with a loud warning if the model cannot load) | on (fail instead) | off
RAG_RERANK_MODEL=jinaai/jina-reranker-v3.5
# RAG_RERANK_REVISION=           # empty = the audited commit for the Jina model
# RAG_TRUST_REMOTE_CODE=1        # only for a custom-code model other than the audited Jina pair
RAG_RERANK_TOP=20                # candidates the reranker reads per query (a listwise model reads them all in one pass: memory grows with it)
RAG_RERANK_MODE=auto             # auto: replace for Jina (it beat hybrid retrieval by +18.6 recall@1), fuse for any other reranker (ms-marco lost 4-14 points when it replaced) | fuse | replace

# --- Pipeline ---
RAG_MAX_CHUNK_TOKENS=500
RAG_ANSWER_POLICY=balanced       # strict | tolerant | balanced | lenient: how strict the answer gate is (see README)
# RAG_MIN_RELEVANCE=0.211        # OFF by default. Refuse before the LLM when the best reranker score is below this. Jina cosine scores; 0.211 refused
                                 # 83% of unanswerable questions and wrongly refused 4-9% of good ones (evals/results/answerability.md)
# RAG_ROUTE_MARGIN=0.10         # document routing, ON by default: when several documents are indexed and the best one leads the next by this reranker margin,
                                 # only its chunks are used (stops answers mixing in a similar-looking document). off = never route. Needs the reranker.
RAG_ANSWER_QUOTES_FIRST=1        # the model writes its evidence before its answer
RAG_PROMPT_SET=fewshot           # optional enrichment: fewshot | grounded | combined_fewshot
RAG_JUDGE=off                    # optional enrichment: off | llm (second-opinion judge)

# --- PDF conversion (needs the `pdf` extra; read once into Settings.pdf, converters.py takes it as an argument) ---
# Two backends: pymupdf4llm (fast, keeps code layout, drops display equations) and Docling (recovers equations, OCR for scans,
# sometimes reorders text or flattens code). `auto` profiles each file (pdf_profile.py): scans and formula-heavy -> Docling.
# See evals/results/pdf_backends.md and golden_trm.md for the measurements; neither backend wins everywhere.
# RAG_PDF_BACKEND=auto           # auto | pymupdf4llm | docling
# RAG_PDF_FORMULAS=1             # Docling's formula model (LaTeX equations); 0 skips loading it
# RAG_PDF_LAYOUT_ENGINE=         # Docling layout model: empty = onnxruntime if onnxruntime-gpu is installed, else torch | onnxruntime | torch
# RAG_CONVERT_CACHE=             # converted-Markdown cache: empty = ~/.cache/rag_template/converted | off | a directory
# RAG_CONVERSION_CHECK=1         # compare each conversion with the PDF's own text at ingest and report problems (never changes the index).
#                                # Needs Poppler's `pdftotext` on the PATH (system package: poppler / poppler-utils); without it the check says "not run".

